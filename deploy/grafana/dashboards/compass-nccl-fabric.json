    {
      "type": "timeseries",
      "title": "Rail transmit rate (bytes on the wire)",
      "description": "Host RDMA exporter (:9500), port_xmit_data in bytes. One rail VF links at 200 Gb/s: the rdma cells should pin the claimed rails near line rate at large messages; the nvlink cells leave them idle.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
