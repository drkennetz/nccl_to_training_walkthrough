    {
      "type": "timeseries",
      "title": "RoCE slow restarts and ICRC errors",
      "description": "rdma_roce_slow_restart: the NIC's congestion control fell back to slow start; rx_icrc_encapsulated: corrupted RoCE packets. Both should stay flat during every cell. (NIC pause-frame counters are not exported on these hosts; the in-pod watcher reads ethtool when it can.)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
