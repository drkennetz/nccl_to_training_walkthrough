{
  "uid": "compass-nccl-fabric",
  "title": "Compass \u2014 NCCL fabric counters",
  "tags": [
    "compass",
    "nccl",
    "gb300"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "The counters behind every bandwidth number in the compass take-home: NVLink and PCIe bytes per GPU (DCGM), per-rail RoCE bytes, congestion and reliability counters, NIC pause frames, and the TCP path's host cost. Benchmark phases are annotations tagged `compass`.",
  "templating": {
    "list": [
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(DCGM_FI_DEV_POWER_USAGE, hostname)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "label": "node"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "benchmark phases",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "#2a78d6",
        "target": {
          "type": "tags",
          "tags": [
            "compass"
          ],
          "matchAny": false,
          "limit": 500
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "GPU side \u2014 what DCGM sees (per GPU)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "NVLink bytes transmitted per GPU",
      "description": "From the host NVLink exporter (:9600), summed over the GPU's links. Multi-node NVLink (MNNVL) and intra-tray NVLink traffic together; rises with the nvlink cells, flat during rdma/tcp cells.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (hostname, gpu) (rate(nvlink_data_tx_kib_total{hostname=~\"$node\"}[$__rate_interval])) * 1024",
          "legendFormat": "{{hostname}} gpu{{gpu}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "NVLink bytes received per GPU",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (hostname, gpu) (rate(nvlink_data_rx_kib_total{hostname=~\"$node\"}[$__rate_interval])) * 1024",
          "legendFormat": "{{hostname}} gpu{{gpu}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "PCIe bytes per GPU (TX + RX)",
      "description": "DCGM profiling fields are already rates (bytes/s over the sample window). GPUDirect RDMA moves data NIC\u2194GPU without the host; with GDR off the same bytes bounce through host memory and this doubles.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
