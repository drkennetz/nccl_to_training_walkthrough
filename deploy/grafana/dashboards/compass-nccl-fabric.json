        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "DCGM_FI_PROF_PCIE_TX_BYTES{hostname=~\"$node\"}",
          "legendFormat": "tx {{hostname}} gpu{{gpu}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "DCGM_FI_PROF_PCIE_RX_BYTES{hostname=~\"$node\"}",
          "legendFormat": "rx {{hostname}} gpu{{gpu}}",
          "refId": "B"
        }
      ]
    },
    {
