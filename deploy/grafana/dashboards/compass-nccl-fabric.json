    {
      "type": "timeseries",
      "title": "Congestion: CNPs sent / handled, ECN-marked packets",
      "description": "DCQCN in action: ECN marks arrive, the receiver answers with CNPs, the sender rate-limits. Non-zero here during a cell is the fabric telling NCCL to slow down \u2014 the counter to read before blaming the network.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
