#!/usr/bin/env bash
# clusters/nearby-woodcock.env — per-cluster settings.
#
# HGX B300 (BM.GPU.B300.8): x86_64, 8 GPUs per node, NVLink only WITHIN a node,
# node-to-node over RoCE (8 rails, rdma_pN_railM). No IMEX, no MNNVL, CliqueId 0.
# Survey values verified 2026-09-26 on GPU-387 (identity-checked, read-only).

CLUSTER_NAME="nearby-woodcock"
SLURM_PARTITION="compute"
# `compute` also holds the aarch64 GB200 nodes (feature gb200config, all drained at
# survey time). Leases must never land on them: the flat node regex already hides
# them, and the constraint makes Slurm enforce it as well.
SLURM_CONSTRAINT="default"
DOMAIN="nearby-woodcock.local"
EXPECTED_ARCH="x86_64"

# ---------- Node selection ----------
# Names are GPU-<n> and carry no topology. Every B300 host has its OWN OCI rack_id
# (82 hosts, 82 rack ids, from /config/mgmt/manage.py nodes list) and all but one
# sit in a single rail of a single network block in /etc/slurm/topology.yaml:
#   phx22_cluster -> network-block w4gj2e2a -> rail wrdz7b4q (the lone GPU-3746 is
#   in rail ajb4prqa). So the NVL72 "rack" has no analogue: the pseudo-rack is that
#   rail, and "multi-rack" on B300 means >1 host.
NODE_TOPOLOGY="flat"
FLAT_NODE_RE='^GPU-([0-9]+)$'
FLAT_RACKID="w4gj2e2a/wrdz7b4q"
# ...and only the nodes Slurm's topology actually places in that rail. GPU-2571 matched the
# name pattern and passed preflight but is absent from topology.yaml: a 32-tray lease that
# included it was refused ("Requested topology configuration is not available").
FLAT_TOPOLOGY_SWITCH="rail::phx22_cluster:w4gj2e2a:wrdz7b4q"
EXCLUDE_LOCALBLOCKS=""
PREFER_LOCALBLOCKS=""

GPUS_PER_NODE=8
GPU_TYPE="B300"          # Gres=gpu:B300:8
INSTANCE_SHAPE="BM.GPU.B300.8"

# ---------- Slurm leases ----------
# Nodes are held by a real placeholder job, never a reservation: HealthCheckNodeState=IDLE,CYCLE
# means the OCI healthcheck drains *idle* nodes every 300s, and ALLOCATED nodes are skipped.
LEASE_CONTROLPLANE_TIME="7-00:00:00"
# Seconds of advance SIGTERM before walltime, so the lease trap can uninstall k3s
# before SIGKILL. Slurm's KillWait here is only 30s, nowhere near enough.
LEASE_SIGNAL_LEAD=300
LEASE_RACK_TIME="3-00:00:00"
LEASE_JOB_PREFIX="k8sboot"
# Set to a reservation name only if you must; empty means normal scheduling.
LEASE_RESERVATION=""

# ---------- Paths ----------
# Node root fs is 247G (~205G free). All cluster/container state goes on the
# 28T NVMe RAID0 (md0) at /mnt/localdisk. NGC images are 20+G each.
NODE_LOCAL_DISK="/mnt/localdisk"
K3S_DATA_DIR="${NODE_LOCAL_DISK}/k3s"
NODE_INSTALL_DIR="/opt/k8s-bootstrap"        # binaries + our scripts, never /usr/local/bin
LOCAL_PATH_ROOT="${NODE_LOCAL_DISK}/local-path"
SHARED_FS="/fss"                              # NFS, mounted on every node

# ---------- Shared (RWX) storage ----------
# From `findmnt /fss`: fss-config.nearby-woodcock.local:/fss, NFSv3, nconnect=16.
# Pod mounts must match the server's version, hence nfsvers=3 rather than 4.1.
NFS_SERVER="fss-config.nearby-woodcock.local"
NFS_SHARE="/fss"
NFS_MOUNT_OPTIONS="nfsvers=3,nconnect=16,hard,timeo=600,retrans=2"
# Every volume we provision lives under this prefix, so teardown can remove OUR
# directories and nothing else. /fss is shared storage with other people's data
# in it (e.g. /fss/dgxc) -- never operate on the share root.
# /etc/slurm/job_container.conf BasePath: Slurm mounts <base>/<jobid> for every running
# job. lib/drift.sh treats exactly those as Slurm's, not teardown leftovers.
SLURM_JOB_CONTAINER_BASE="/mnt/localdisk/slurm-tmp"
# Listening ports the site's own checks open and close on idle trays: the multi-node health
# check's ib_write_bw servers, one per rail VRF (vrf_r0..7 -> 18001..18008). lib/drift.sh treats
# exactly these as the site's.
SITE_TRANSIENT_PORTS="18001-18008"
NFS_SUBDIR_PREFIX="k8s-bootstrap"
STATE_DIR="${HOME}/.local/state/k8s-bootstrap/${CLUSTER_NAME}"

# ---------- Networking ----------
# Node network is 172.16.0.0/12-ish and docker0 is 172.17.0.0/16. No 10.x routes
# exist on any node, so 10.42/10.43 are free. Verified with `ip route`.
POD_CIDR="10.42.0.0/16"
SERVICE_CIDR="10.43.0.0/16"
CLUSTER_DNS="10.43.0.10"
# Controller is 172.16.0.0/24, B300 nodes 172.16.32.0/19 (no 10.x routes on GPU-387).
# Tunnel kept for parity with polite-possum. Native routing would need fabric changes we must not make.
CILIUM_ROUTING_MODE="tunnel"
CILIUM_TUNNEL_PROTOCOL="geneve"

# ---------- Host daemons we scrape but never manage ----------
# Deploying our own node-exporter (:9100) or dcgm-exporter (:9400) would collide.
# Verified by curling /metrics on a live node and reading the metric names --
# do NOT infer this mapping from the binaries in /usr/local/bin, which is how it
# was got wrong the first time (9500/9600/9700 were rotated).
#   9100 node_exporter                  9400 dcgm-exporter
#   9500 rdma_counters_exporter.py      (rdma_packet_seq_err, ...)
#   9600 nvlink_counters_exporter.py    (nvlink_data_tx_kib_total, ...)
#   9700 pcie_faults_exporter.py        (pcie_aer_correctable_error_count, ...)
#
# :9876 is deliberately ABSENT. It is /opt/oci-hpc/http_server/bin/http_server.py,
# a plain directory-listing file server for the healthcheck logs -- /metrics
# returns 404 and text/html. Scraping it just produces a permanently-down target.
HOST_SCRAPE_PORTS="9100 9400 9500 9600 9700"

# :9800 serves only process_* metrics (no exporter payload) -- not scraped.

# ---------- GPU / IMEX ----------
# HGX: nvidia-imex is inactive and there is no channel device; preflight WARNs on
# both, which is expected here. Multi-node traffic is RoCE, not MNNVL.
IMEX_PATH="none"
IMEX_CHANNEL_DEV="/dev/nvidia-caps-imex-channels/channel0"
HOST_CDI_SPEC="/var/run/cdi/nvidia.yaml"
