#!/usr/bin/env bash
# versions.env — SINGLE SOURCE OF TRUTH for every pinned version in this repo.
#
# Every script sources this file; README.md renders it. Never hardcode a version
# anywhere else. Bump here, test via a gitops overlay, then commit.
#
# All versions verified 2026-09-10 against upstream release channels.
# Re-check with: bin/k8s-check-upgrades
#
# RULE: pin STABLE releases only. Never pin an rc/pre/alpha/beta tag. ArtifactHub
# and some chart indexes surface pre-releases as "latest" (it was offering Cilium
# 1.21.0-pre.2 on 2026-09-10 while stable was 1.20.1).

# ---------- Kubernetes distribution ----------
# Default provider. k3s tracks one minor behind upstream; see docs/PLAN.md for why
# that is acceptable here (DRA is GA as of k8s 1.34, so it is present in 1.36).
K3S_VERSION="v1.36.4+k3s1"
K3S_INSTALL_URL="https://get.k3s.io"

# Alternate provider (providers/kubeadm.sh). Exactly upstream latest stable.
KUBEADM_K8S_VERSION="v1.37.0"

# Kubernetes minor EOL dates, for upgrade planning:
#   1.37 -> 2027-10-28   1.36 -> 2027-06-28   1.35 -> 2027-02-28   1.34 -> 2026-10-27

# ---------- Tooling (installed on the controller only) ----------
HELM_VERSION="v4.3.0"
KUBECTL_VERSION="v1.37.0"   # keep within one minor of the server

# ---------- CNI ----------
CILIUM_VERSION="1.20.1"
CILIUM_CHART_VERSION="1.20.1"
CILIUM_HELM_REPO="https://helm.cilium.io"

# ---------- GPU ----------
GPU_OPERATOR_VERSION="v26.7.0"
GPU_OPERATOR_CHART_VERSION="v26.7.0"
GPU_OPERATOR_HELM_REPO="https://helm.ngc.nvidia.com/nvidia"
# DRA driver is bundled with the operator chart. Path B only -- see docs/PLAN.md.
# Enabling it requires masking the host nvidia-imex.service, which we do NOT do by default.
NVIDIA_DRA_DRIVER_VERSION="v0.5.0"

# Host-preinstalled versions we depend on but do NOT manage. Assert, never install.
EXPECTED_NVIDIA_DRIVER_MIN="580"       # DRA driver requires >= 580; nodes ship 595.71.05
EXPECTED_CONTAINER_TOOLKIT_MIN="1.17"  # nodes ship 1.20.0

# ---------- GitOps ----------
ARGOCD_VERSION="v3.5.2"
ARGOCD_CHART_VERSION="10.8.4"
ARGOCD_HELM_REPO="https://argoproj.github.io/argo-helm"

# ---------- Monitoring ----------
KUBE_PROMETHEUS_STACK_CHART_VERSION="90.0.0"
PROMETHEUS_OPERATOR_VERSION="v0.93.1"
PROMETHEUS_HELM_REPO="https://prometheus-community.github.io/helm-charts"

# ---------- Storage ----------
LOCAL_PATH_PROVISIONER_VERSION="v0.0.37"
LOCAL_PATH_PROVISIONER_CHART_VERSION="0.0.38"
CSI_DRIVER_NFS_VERSION="4.13.4"
CSI_DRIVER_NFS_CHART_VERSION="4.13.4"
CSI_DRIVER_NFS_HELM_REPO="https://raw.githubusercontent.com/kubernetes-csi/csi-driver-nfs/master/charts"

# ---------- Batch / scheduling ----------
KUEUE_VERSION="v0.19.4"

# ---------- Optional cluster UI ----------
HEADLAMP_VERSION="0.45.0"
HEADLAMP_CHART_VERSION="0.45.0"
HEADLAMP_HELM_REPO="https://kubernetes-sigs.github.io/headlamp"

# ---------- Deliberately NOT used ----------
# ingress-nginx: archived 2026-03-24. No releases, bugfixes, or security updates.
#   Upstream directs new users to a Gateway API implementation. We use Cilium's
#   Gateway API, which adds no new component.
# metallb / cilium LB-IPAM / L2 announcements: would squat on IPs in a managed
#   subnet that is not ours. Use NodePort + `kubectl port-forward`.
